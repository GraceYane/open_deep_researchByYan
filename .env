#GOOGLE_API_KEY=
#TAVILY_API_KEY=
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=
#LANGSMITH_TRACING=false
#
## Only necessary for Open Agent Platform
#SUPABASE_KEY=
#SUPABASE_URL=
## Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
#GET_API_KEYS_FROM_CONFIG=false

# DeepSeek 官方密钥
DEEPSEEK_API_KEY=换成DeepSeek的API

# 四个阶段全部使用 DeepSeek
SUMMARIZATION_MODEL=deepseek:deepseek-flash
RESEARCH_MODEL=deepseek:deepseek-flash
COMPRESSION_MODEL=deepseek:deepseek-flash
FINAL_REPORT_MODEL=deepseek:deepseek-flash

# 每次输出的 token 上限
SUMMARIZATION_MODEL_MAX_TOKENS=8192
RESEARCH_MODEL_MAX_TOKENS=8192
COMPRESSION_MODEL_MAX_TOKENS=8192
FINAL_REPORT_MODEL_MAX_TOKENS=8192

# 联网搜索仍然需要单独配置
#SEARCH_API=tavily
SEARCH_API=none
#TAVILY_API_KEY=填写你的Tavily密钥

GET_API_KEYS_FROM_CONFIG=false
LANGSMITH_TRACING=false